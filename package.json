{
  "name": "onflow",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "api:dev": "python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000 --app-dir services/api",
    "api:generate": "node scripts/generate-openapi-types.mjs",
    "api:check": "node scripts/generate-openapi-types.mjs --check",
    "api:test": "node scripts/run-api-pytest.mjs",
    "verify:phase0": "npm run typecheck && npm run lint && npm run verify:boundaries && npm run api:check && npm run test",
    "verify:all": "npm run verify:phase0 && npm run api:test",
    "bundle:ios": "expo export --platform ios --output-dir dist-ios",
    "download:ios": "node scripts/download-eas-ios.mjs",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:production:ios": "eas build --profile production --platform ios",
    "submit:ios": "eas submit --profile production --platform ios --latest"
  },
  "dependencies": {
    "@expo-google-fonts/bebas-neue": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/sora": "^0.4.1",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~53.0.0",
    "expo-apple-authentication": "~7.2.4",
    "expo-asset": "~11.1.7",
    "expo-camera": "~16.1.11",
    "expo-constants": "~17.1.3",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.0",
    "expo-haptics": "~14.1.4",
    "expo-image-picker": "~16.1.4",
    "expo-linking": "~7.1.3",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "expo-video": "~2.2.2",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-mmkv": "^3.3.3",
    "react-native-purchases": "^10.4.4",
    "react-native-purchases-ui": "^10.4.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "eslint": "^9.35.0",
    "eslint-plugin-import": "^2.32.0",
    "openapi-typescript": "^7.9.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.4"
  }
}
