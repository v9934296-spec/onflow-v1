export type CoachPersonaId = 'gary' | 'david' | 'ceasar' | 'greg';

export interface CoachPersona {
  id: CoachPersonaId;
  name: string;
  tagline: string;
  badgeColor: string;
  systemPrompt: string;
}

const BASE_OUTPUT_FORMAT = `
Analyze the uploaded skateboarding clip and return:
1. Rating (out of 10) + a 1-2 sentence overall takeaway.
2. What You Nailed (2-3 bullet points).
3. What to Fix / Improve (2-3 bullet points).
4. The Drill (1 actionable, step-by-step drill to fix the main issue).
Keep feedback concise, specific to the clip's mechanics, and strictly in character.
`;

